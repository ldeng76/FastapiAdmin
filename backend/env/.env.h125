REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api/v1"               # API路由前缀
DESCRIPTION = "肺结节研究系统后端API服务"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "postgres"  # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "localhost"
DATABASE_PORT = 5432  # MySQL:3306 PostgreSQL:5432
DATABASE_USER = "lnrs"
DATABASE_PASSWORD = "lnrs_pwd_2026"
DATABASE_NAME = "postgres"
DATABASE_SCHEMA = "lnrs"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = ""
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "INFO"   # 日志级别

# IP 归属地查询（登录时对外请求第三方 API，生产建议关闭）
IP_LOCATION_ENABLE=false