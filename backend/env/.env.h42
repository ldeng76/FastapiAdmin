# ==================================
# h42 环境配置文件
# 初始配置与 dev 相同，按需修改
# ==================================

ENVIRONMENT = "h42"

# 服务器配置
SERVER_HOST = "192.168.1.42"     # 允许访问的IP地址
SERVER_PORT = 8610          # 服务端口

# 文档配置
DEBUG = True                        # 调试模式
TITLE = "🎉 FastapiAdmin 🎉 -h42"    # 文档标题
VERSION = "0.1.0"                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api/v1"               # API路由前缀
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "postgres"  # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "192.168.1.59"
DATABASE_PORT = 5432  # MySQL:3306 PostgreSQL:5432
DATABASE_USER = "lnrs"
DATABASE_PASSWORD = "lnrs_pwd"
DATABASE_NAME = "postgres"
DATABASE_SCHEMA = "lnrs"

# Redis配置
REDIS_ENABLE = True
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = ""
REDIS_DB_NAME = 7

# 日志配置
LOGGER_LEVEL = "DEBUG"   # 日志级别

# 大模型配置
OPENAI_BASE_URL = "https://api.deepseek.com"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-v4-flash"

# IP 归属地查询（登录时对外请求第三方 API，生产建议关闭）
IP_LOCATION_ENABLE=false

# DICOM 影像数据根目录（其下每个子目录视为一个 Study）
DICOM_DATA_DIR = "/home/dzy/wk/lnrs_dicom_dats"

# ETL-2 脱敏落库配置（ADR-0001/0006）
LNRS_ANON_SECRET = "change-me-in-production-please"
LNRS_ANON_SECRET_VERSION = "v1"
LNRS_DATA_ROOT = "/home/dzy/wk/lnrs_dats"

# 验证码（开发环境关闭，避免登录页被验证码阻塞）
CAPTCHA_ENABLE = False
