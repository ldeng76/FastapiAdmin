ENVIRONMENT = "h125"

# 服务器配置
SERVER_HOST = "0.0.0.0"     # 允许访问的IP地址
SERVER_PORT = 8610          # 服务端口

# 文档配置
DEBUG = False                        # 调试模式
TITLE = "🎉 肺结节研究系统 🎉 "    # 文档标题
VERSION = "1.0.1"                    # 版本号
SUMMARY = "接口汇总"                 # 文档概述
