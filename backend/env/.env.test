# ==================================
# 测试环境配置 — 指向可丢弃的沙箱库，绝不指向真库
# ==================================
#
# 用途：pytest 里所有**写库**测试（tests/anon_etl/ 下 5 个文件）必须在此环境下运行。
#
# 背景（2026-09-20 事故）：一个测试用真实中心名清理 batch，
# 经 dicom_series.created_batch_id 的 ON DELETE CASCADE 删掉 168,260 行。
# 根因是「测试连的是真库且无隔离」。
# 复盘：docs/etl2/findings/incident-20260920-test-cascade-delete.md
#
# 沙箱：同实例上的独立**数据库** lnrs_dev（不是 schema —— 代码里有 470 处硬编码
# `lnrs.` 前缀，会绕过 search_path；独立库里 `lnrs` 是另一个同名 schema，
# 硬编码原样生效且指向沙箱）。
#
# 用法：
#   cd backend && ENVIRONMENT=test uv run pytest tests/anon_etl/
#
# 安全闸：测试侧会断言 DATABASE_NAME 不在「真库名」集合内，否则**直接 fail**（不是 skip）。
# 因此把本文件的 DATABASE_NAME 改成 postgres 会让测试立刻炸掉，而不是静默写真库。

ENVIRONMENT = "test"

# 服务器配置
SERVER_HOST = "localhost"
SERVER_PORT = 8001

# 文档配置
DEBUG = True
TITLE = "🎉 FastapiAdmin 🎉 -test"
VERSION = "0.1.0"
SUMMARY = "接口汇总"
DOCS_URL = "/docs"
REDOC_URL = "/redoc"
ROOT_PATH = "/api/v1"
DESCRIPTION = "测试环境（沙箱库 lnrs_dev）"

DEMO_ENABLE = False

# 数据库配置 —— 同一实例，独立数据库（沙箱）
DATABASE_TYPE = "postgres"
DATABASE_HOST = "127.0.0.1"
DATABASE_PORT = 5432
DATABASE_USER = "lnrs"
DATABASE_PASSWORD = "lnrs_pwd"
DATABASE_NAME = "lnrs_dev"          # ← 沙箱库；改成 postgres 会被安全闸拦下
DATABASE_SCHEMA = "lnrs"

# Redis配置 —— 用独立 DB 号，避免测试污染 dev(1) / h196_3(7) 的键
REDIS_ENABLE = True
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "your_redis_password"
REDIS_DB_NAME = 15

LOGGER_LEVEL = "DEBUG"

# 大模型配置
OPENAI_BASE_URL = "https://api.deepseek.com"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-v4-flash"

IP_LOCATION_ENABLE = false
CAPTCHA_ENABLE = False
CAPTCHA_MODE = "altcha"
ALTCHA_HMAC_KEY = ""

# DICOM 影像数据根目录（测试用 tmp_path，此值仅占位）
DICOM_DATA_DIR = "path/to/dicom_demo"

# ETL-2 脱敏落库配置
LNRS_ANON_SECRET = "change-me-in-production-please"
LNRS_ANON_SECRET_VERSION = "v1"
LNRS_DATA_ROOT = "../data"

# Web 部署面板（测试值；指向 dummy）
OPS_DEPLOY_PASSWORD = "dev-deploy-123"
OPS_DEPLOY_SLUG = "devops01"
OPS_DEPLOY_SCRIPT = "/home/dzy/wk/lnrs/scripts/web-deploy-dummy.sh"
